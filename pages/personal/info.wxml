<include src="../template/error.wxml" />
<form bindsubmit="submit">
  <input hidden name="id" value="{{information.id}}"></input>
  <view class="info-main">
    <view class="form-container">
      <view class="form-title">个人信息</view>
      <view class="form-cells">
        <view class="form-cell">
          <view class="form-cell_lable">
            <text decode='true'>姓&emsp;&emsp;名:</text>
          </view>
          <view class="form-cell_val">
            <input class='form-cell_input' name="name" placeholder="请输入您的真实姓名" type='text' value="{{information.name}}"></input>
          </view>
        </view>
        <view class="form-cell">
          <view class="form-cell_lable"><text decode='true'>性&emsp;&emsp;别:</text></view>

          <radio-group class="form-cell_input flex" bindchange="radioChoose" bindblur="bindKeyInput" name="sex">
            <label class="flex flex1">
              <radio color="#fff" value="1" checked='{{information.sex==1?"checked":""}}' />
              <text class="radio-lable">男</text>
            </label>
            <label class="flex flex1">
              <radio color="#fff" value="2" checked='{{information.sex==2?"checked":""}}' />
              <text class="radio-lable">女</text>
            </label>
          </radio-group>
        </view>
        <!--
        <view class="form-cell">
          <view class="form-cell_lable"><text  decode='true'>微信号码:</text></view>
          <input class='form-cell_input' bindblur="bindKeyInput" data-type="wx" data-index="2" placeholder="请输入您的微信号码" type='text' value="{{vals[2]}}"></input>
        </view>
      -->


        <view class="form-cell">
          <view class="form-cell_lable"><text decode='true'>手机号码:</text></view>
          <input disabled="true" class='form-cell_input' name="phoneNum" placeholder="请授权您的手机号码" type='text' value="{{information.phoneNum}}"></input>
          <button open-type="getPhoneNumber" class="btn_primary" style="padding:5rpx 10rpx;border-radius: 10rpx;font-size: 20rpx;" bindgetphonenumber="getPhoneNumber">授权</button>
        </view>

        <view class="form-cell">
          <view class="form-cell_lable"><text decode='true'>出生日期:</text></view>
          <picker name="birthday" value="{{information.birthday}}" class='form-cell_input' style="line-height:88rpx;" mode="date" start="1915-01-01" end="new Date()" bindchange="pickerChange" data-type="birthday">
            <text class="{{information.birthday ? '':'input-placeholder'}}">{{information.birthday?information.birthday:'请选择您的出生日期'}}</text>
          </picker>
        </view>
        <view class="form-cell">
          <view class="form-cell_lable"><text decode='true'>教育程度:</text></view>
          <picker class='form-cell_input' name="education" value="{{information.education}}" style="line-height:88rpx;" bindchange="pickerChange" value="{{information.education}}" range="{{arrayeducation}}" data-type="education">
            <text wx:if='{{vals[4]}}'>{{information.education}}</text>
            <text class="{{information.education?'':'input-placeholder'}}">{{information.education?arrayeducation[information.education]:'请选择您的教育程度'}}</text>
          </picker>
        </view>
        <view class='btns'>
          <button class='btn btn_cancel' bindtap='cancel'>取消</button>
          <button class='btn btn_primary' form-type="submit">保存</button>
        </view>
      </view>
    </view>
  </view>
</form>